<Project>
  <PropertyGroup>
    <Version>0.2.1</Version>
    <ArenaRepoRoot>$(MSBuildThisFileDirectory)</ArenaRepoRoot>
    <!-- Game binaries + BepInEx (EscapeFromTarkov.exe, Managed/, BepInEx/) -->
    <SPTPath>$(MSBuildThisFileDirectory)..\..</SPTPath>
    <!-- Profiles, server mods, configs (user/) — 4.1 renamed the nested folder SPT -> SPT_Runtime -->
    <SPTUserPath>$(MSBuildThisFileDirectory)..\..\SPT_Runtime</SPTUserPath>
    <AssemblySearchPaths>
      $(SPTPath)\EscapeFromTarkov_Data\Managed;
      $(SPTPath)\BepInEx\plugins\spt;
      $(AssemblySearchPaths)
    </AssemblySearchPaths>
  </PropertyGroup>

  <Import Project="Shared.props.user" Condition="Exists('Shared.props.user')" />

  <Target Name="SPTClientDeploy" AfterTargets="PostBuildEvent" Condition="'$(SPTModType)'=='Client'">
    <!-- Preserve this suppressible boundary for every offline/staged build. -->
    <Exec Command='pwsh -NoLogo -NoProfile -File "$(ArenaRepoRoot)tools\Deploy-ArenaClient.ps1" -AssemblyPath "$(TargetPath)" -SptPath "$(SPTPath)" -Configuration "$(Configuration)"' />
  </Target>
</Project>
