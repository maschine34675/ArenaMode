<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <MarkerSource Condition="'$(MarkerSource)' == ''">../../ArenaMode.Client/Compat/DynamicMapsDominationMarkers.cs</MarkerSource>
    <ApiFixture Condition="'$(ApiFixture)' == ''">Legacy121</ApiFixture>
    <DefineConstants Condition="'$(ApiFixture)' == 'Modern130' Or '$(ApiFixture)' == 'UnknownShape'">$(DefineConstants);DYNAMICMAPS_130</DefineConstants>
    <DefineConstants Condition="'$(ApiFixture)' == 'UnknownShape'">$(DefineConstants);DYNAMICMAPS_BAD_SHAPE</DefineConstants>
  </PropertyGroup>
  <ItemGroup><Compile Include="$(MarkerSource)" Link="Production/DynamicMapsDominationMarkers.cs" /></ItemGroup>
</Project>
