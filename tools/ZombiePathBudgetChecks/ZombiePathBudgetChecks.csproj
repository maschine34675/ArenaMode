    <PolicySource Condition="'$(PolicySource)' == ''">../../ArenaMode.Client/Bots/ZombiePathBudgetPolicy.cs</PolicySource>
    <RuntimeSource Condition="'$(RuntimeSource)' == ''">../../ArenaMode.Client/Bots/ZombiePathBudgetRuntime.cs</RuntimeSource>
    <TranspilerSource Condition="'$(TranspilerSource)' == ''">../../ArenaMode.Client/Bots/ZombiePathBudgetTranspiler.cs</TranspilerSource>
    <MeleeSource Condition="'$(MeleeSource)' == ''">../../ArenaMode.Client/Bots/ZombieMeleePatch.cs</MeleeSource>
