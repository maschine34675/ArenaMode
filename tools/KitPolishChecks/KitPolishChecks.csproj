<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <SummarySource Condition="'$(SummarySource)' == ''">../../ArenaMode.Client/Kits/KitSummary.cs</SummarySource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove=".work/**" />
    <Compile Remove="Supplies/**" />
    <Compile Include="$(SummarySource)" Link="Production/KitSummary.cs" />
    <Compile Include="../../ArenaMode.Client/Kits/KitModels.cs" Link="Production/KitModels.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
