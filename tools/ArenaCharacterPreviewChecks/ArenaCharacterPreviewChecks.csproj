<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PreviewStateSource Condition="'$(PreviewStateSource)' == ''">../../ArenaMode.Client/Session/Preview/ArenaPreviewLifetimeState.cs</PreviewStateSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(PreviewStateSource)" Link="Production/ArenaPreviewLifetimeState.cs" />
  </ItemGroup>
</Project>
