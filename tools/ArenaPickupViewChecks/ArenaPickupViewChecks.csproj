<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ViewSource Condition="'$(ViewSource)' == ''">$(MSBuildThisFileDirectory)..\..\ArenaMode.Client\Pickups\ArenaPickupView.cs</ViewSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Doubles.cs" />
    <!-- The real marker view; Verify.ps1 points ViewSource at mutated temp copies. -->
    <Compile Include="$(ViewSource)" Link="Production/ArenaPickupView.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\ArenaMode.Client\Pickups\ArenaPickupColors.cs" Link="Production/ArenaPickupColors.cs" />
  </ItemGroup>
</Project>
