<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AnnouncementPolicySource Condition="'$(AnnouncementPolicySource)' == ''">$(MSBuildThisFileDirectory)..\..\ArenaMode.Client\Audio\ArenaAnnouncementPolicy.cs</AnnouncementPolicySource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AnnouncementPolicySource)" Link="Production/ArenaAnnouncementPolicy.cs" />
    <Compile Include="../../ArenaMode.Client/Audio/ArenaAnnouncementSnapshot.cs" Link="Production/ArenaAnnouncementSnapshot.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/ArenaAnnouncerCue.cs" Link="Production/ArenaAnnouncerCue.cs" />
  </ItemGroup>
</Project>
