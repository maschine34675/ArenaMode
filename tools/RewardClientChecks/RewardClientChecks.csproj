<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <RewardBufferSource Condition="'$(RewardBufferSource)' == ''">../../ArenaMode.Client/Session/RewardCaptureBuffer.cs</RewardBufferSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(RewardBufferSource)" Link="RewardCaptureBuffer.cs" />
    <Compile Include="../../ArenaMode.Shared/RewardWire.cs" Link="RewardWire.cs" />
  </ItemGroup>
</Project>
