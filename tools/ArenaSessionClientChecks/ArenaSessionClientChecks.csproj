<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Each production source can be swapped for a mutated copy (Verify.ps1). -->
    <ProductionDecisionSource Condition="'$(ProductionDecisionSource)' == ''">../../ArenaMode.Shared/Session/ArenaWhitelistDecision.cs</ProductionDecisionSource>
    <ProductionModeSource Condition="'$(ProductionModeSource)' == ''">../../ArenaMode.Client/Session/ArenaSessionMode.cs</ProductionModeSource>
    <ProductionAdmissionSource Condition="'$(ProductionAdmissionSource)' == ''">../../ArenaMode.Client/Session/ArenaWhitelistAdmission.cs</ProductionAdmissionSource>
    <ProductionSwitchSource Condition="'$(ProductionSwitchSource)' == ''">../../ArenaMode.Client/Session/ArenaSessionSwitch.cs</ProductionSwitchSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ArenaMode.Shared/RewardWire.cs" Link="Production/Shared/RewardWire.cs" />
    <Compile Include="../../ArenaMode.Shared/Session/ArenaMiniJson.cs" Link="Production/Shared/ArenaMiniJson.cs" />
    <Compile Include="../../ArenaMode.Shared/Session/ArenaWhitelistPolicy.cs" Link="Production/Shared/ArenaWhitelistPolicy.cs" />
    <Compile Include="$(ProductionDecisionSource)" Link="Production/Shared/ArenaWhitelistDecision.cs" />
    <Compile Include="../../ArenaMode.Shared/Session/ArenaSessionContract.cs" Link="Production/Shared/ArenaSessionContract.cs" />
    <!-- The helper's request parser, which ArenaSessionSwitch runs before the game quits. -->
    <Compile Include="../../ArenaMode.Session/SessionLogic.cs" Link="Production/Shared/SessionLogic.cs" />
    <Compile Include="$(ProductionModeSource)" Link="Production/ArenaSessionMode.cs" />
    <Compile Include="$(ProductionAdmissionSource)" Link="Production/ArenaWhitelistAdmission.cs" />
    <Compile Include="$(ProductionSwitchSource)" Link="Production/ArenaSessionSwitch.cs" />
    <Compile Include="../../ArenaMode.Client/Session/ArenaHelperProcess.cs" Link="Production/ArenaHelperProcess.cs" />
  </ItemGroup>
</Project>
