<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);ZOMBIE_SOLO_CHECKS</DefineConstants>
    <ModeSource Condition="'$(ModeSource)' == ''">../../ArenaMode.Client/Modes/ZombieMode.cs</ModeSource>
    <MatchSource Condition="'$(MatchSource)' == ''">../../ArenaMode.Client/Modes/ArenaMatch.cs</MatchSource>
    <ExitSource Condition="'$(ExitSource)' == ''">../../ArenaMode.Client/Modes/TdmMatchExit.cs</ExitSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ZombieTeamChecks/Stubs.cs" Link="BoundaryDoubles.cs" />
    <Compile Include="$(ModeSource)" Link="Production/ZombieMode.cs" />
    <Compile Include="$(MatchSource)" Link="Production/ArenaMatch.cs" />
    <Compile Include="$(ExitSource)" Link="Production/TdmMatchExit.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/ZombieTeamRuntime*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../ArenaMode.Client/Modes/ZombieWavePolicy.cs" Link="Production/ZombieWavePolicy.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/ZombieRefillPolicy.cs" Link="Production/ZombieRefillPolicy.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/ArenaMatchResult.cs" Link="Production/ArenaMatchResult.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/ArenaScoreboard.cs" Link="Production/ArenaScoreboard.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/IArenaMode.cs" Link="Production/IArenaMode.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/ArenaAnnouncerCue.cs" Link="Production/ArenaAnnouncerCue.cs" />
    <Compile Include="../../ArenaMode.Client/Combat/ArenaCombatAwards.cs" Link="Production/ArenaCombatAwards.cs" />
    <Compile Include="../../ArenaMode.Client/Combat/ArenaKill.cs" Link="Production/ArenaKill.cs" />
    <Compile Include="../../ArenaMode.Client/Combat/ArenaShotAwardHistory.cs" Link="Production/ArenaShotAwardHistory.cs" />
    <Compile Include="../../ArenaMode.Client/Combat/ScoreRules.cs" Link="Production/ScoreRules.cs" />
    <Compile Include="../../ArenaMode.Client/Respawn/ArenaReplayWaitPolicy.cs" Link="Production/ArenaReplayWaitPolicy.cs" />
    <Compile Include="../../ArenaMode.Client/Respawn/ArenaDeathReplayHold.cs" Link="Production/ArenaDeathReplayHold.cs" />
  </ItemGroup>
</Project>
