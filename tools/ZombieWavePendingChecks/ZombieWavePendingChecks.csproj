<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <ModeSource Condition="'$(ModeSource)' == ''">../../ArenaMode.Client/Modes/ZombieMode.cs</ModeSource>
    <WaveSource Condition="'$(WaveSource)' == ''">../../ArenaMode.Client/Modes/ZombieWavePolicy.cs</WaveSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ArenaMode.Client/Combat/ArenaFriendlyFireRoster.cs" Link="Production/ArenaFriendlyFireRoster.cs" />
    <Compile Remove="ServiceChecks/**" />
    <Compile Include="../ZombieTeamChecks/Stubs.cs" Link="BoundaryDoubles.cs" />
    <Compile Include="$(ModeSource)" Link="Production/ZombieMode.cs" />
    <Compile Include="$(WaveSource)" Link="Production/ZombieWavePolicy.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/ZombieTeamRuntime*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../ArenaMode.Client/Modes/ZombieRefillPolicy.cs" Link="Production/ZombieRefillPolicy.cs" />
    <Compile Include="../../ArenaMode.Client/Respawn/ArenaReplayWaitPolicy.cs" Link="Production/ArenaReplayWaitPolicy.cs" />
  </ItemGroup>
</Project>
