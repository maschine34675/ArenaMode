<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EntrySource Condition="'$(EntrySource)' == ''">../../ArenaMode.Client/Kits/TeamArenaEntryKit.cs</EntrySource>
    <BuilderSource Condition="'$(BuilderSource)' == ''">../../ArenaMode.Client/Kits/KitBuilder.cs</BuilderSource>
    <TransactionSource Condition="'$(TransactionSource)' == ''">obj/Transaction.cs</TransactionSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;Doubles.cs;$(EntrySource);$(BuilderSource);$(TransactionSource)" />
    <Compile Include="../../ArenaMode.Client/Kits/KitModels.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
