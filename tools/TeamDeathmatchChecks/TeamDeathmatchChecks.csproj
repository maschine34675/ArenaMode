<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PopulationSource Condition="'$(PopulationSource)' == ''">../../ArenaMode.Client/Modes/TeamDeathmatchPopulation.cs</PopulationSource>
    <ScoreboardSource Condition="'$(ScoreboardSource)' == ''">../../ArenaMode.Client/Modes/ArenaScoreboard.cs</ScoreboardSource>
    <SpawnDispatchSource Condition="'$(SpawnDispatchSource)' == ''">../../ArenaMode.Client/Bots/TeamDeathmatchSpawnDispatch.cs</SpawnDispatchSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PopulationSource)" Link="Production/TeamDeathmatchPopulation.cs" />
    <Compile Include="$(ScoreboardSource)" Link="Production/ArenaScoreboard.cs" />
    <Compile Include="$(SpawnDispatchSource)" Link="Production/TeamDeathmatchSpawnDispatch.cs" />
    <Compile Include="../../ArenaMode.Client/Combat/ArenaKill.cs" Link="Production/ArenaKill.cs" />
    <Compile Include="../../ArenaMode.Client/Combat/ScoreRules.cs" Link="Production/ScoreRules.cs" />
    <Compile Include="../../ArenaMode.Client/Combat/ArenaCombatAwards.cs" Link="Production/ArenaCombatAwards.cs" />
  </ItemGroup>
</Project>
