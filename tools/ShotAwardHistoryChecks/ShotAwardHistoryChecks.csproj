<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ShotHistorySource Condition="'$(ShotHistorySource)' == ''">$(MSBuildThisFileDirectory)../../ArenaMode.Client/Combat/ArenaShotAwardHistory.cs</ShotHistorySource>
    <HitHistorySource Condition="'$(HitHistorySource)' == ''">$(MSBuildThisFileDirectory)../../ArenaMode.Client/Combat/ArenaHitHistory.cs</HitHistorySource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(ShotHistorySource)" Link="Production/ArenaShotAwardHistory.cs" />
    <Compile Include="$(HitHistorySource)" Link="Production/ArenaHitHistory.cs" />
  </ItemGroup>
</Project>
