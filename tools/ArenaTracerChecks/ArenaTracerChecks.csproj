<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ProductionColorSource Condition="'$(ProductionColorSource)' == ''">../../ArenaMode.Client/Effects/ArenaTracerColor.cs</ProductionColorSource>
    <ProductionTeamsSource Condition="'$(ProductionTeamsSource)' == ''">../../ArenaMode.Client/Effects/ArenaTracerTeams.cs</ProductionTeamsSource>
    <ProductionPatchSource Condition="'$(ProductionPatchSource)' == ''">../../ArenaMode.Client/Effects/ArenaTracerPatches.cs</ProductionPatchSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductionColorSource)" Link="Production/ArenaTracerColor.cs" />
    <Compile Include="$(ProductionTeamsSource)" Link="Production/ArenaTracerTeams.cs" />
    <Compile Include="$(ProductionPatchSource)" Link="Production/ArenaTracerPatches.cs" />
  </ItemGroup>
</Project>
