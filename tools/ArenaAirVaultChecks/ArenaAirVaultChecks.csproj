<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <AirVaultSource Condition="'$(AirVaultSource)' == ''">../../ArenaMode.Client/Movement/ArenaAirVault.cs</AirVaultSource>
      <AirVaultAnimatorSource Condition="'$(AirVaultAnimatorSource)' == ''">../../ArenaMode.Client/Movement/ArenaAirVault.Animator.cs</AirVaultAnimatorSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AirVaultAnimatorSource)" Link="Production/ArenaAirVault.Animator.cs" />
    <Compile Include="$(AirVaultSource)" Link="Production/ArenaAirVault.cs" />
    <Compile Include="$(NativeSource)" Link="Native/Extracted.cs" />
    <Compile Include="../../../_decompiled/EFT.Vaulting/VaultingGameplayRestrictions.cs" Link="Native/VaultingGameplayRestrictions.cs" />
  </ItemGroup>
</Project>
