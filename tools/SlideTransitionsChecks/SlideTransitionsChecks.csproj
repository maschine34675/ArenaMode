<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable><LangVersion>latest</LangVersion>
    <SlideSource Condition="'$(SlideSource)' == ''">../../ArenaMode.Client/Movement/ArenaSlideController.cs</SlideSource>
    <TransitionsSource Condition="'$(TransitionsSource)' == ''">../../ArenaMode.Client/Movement/ArenaSlideTransitions.cs</TransitionsSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SlideSource)" Link="Production/ArenaSlideController.cs" />
    <Compile Include="$(TransitionsSource)" Link="Production/ArenaSlideTransitions.cs" />
    <Compile Include="../../ArenaMode.Client/Movement/ArenaMovementScope.cs" Link="Production/ArenaMovementScope.cs" />
  </ItemGroup>
</Project>
