<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><StartupObject>DominationPlacementEntry</StartupObject><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PickupSourceRoot Condition="'$(PickupSourceRoot)' == ''">../../ArenaMode.Client/Pickups</PickupSourceRoot>
    <SpacingSource Condition="'$(SpacingSource)' == ''">../../ArenaMode.Client/Pickups/ArenaObjectivePickupSpacing.cs</SpacingSource><RuntimeSource Condition="'$(RuntimeSource)' == ''">../../ArenaMode.Client/Pickups/ArenaPickupRuntime.cs</RuntimeSource><MapSource Condition="'$(MapSource)' == ''">../../ArenaMode.Client/Pickups/ArenaPickupMapLayout.cs</MapSource><PickupAudioSource Condition="'$(PickupAudioSource)' == ''">../../ArenaMode.Client/Pickups/ArenaPickupAudio.cs</PickupAudioSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ArenaMode.Shared/ArenaPopulationPolicy.cs" Link="ArenaPopulationPolicy.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="DominationPlacementProgram.cs"/><Compile Include="$(SpacingSource)"/><Compile Include="../ArenaPickupChecks/Program.cs"/><Compile Include="../ArenaPickupChecks/Doubles.cs"/>
    <Compile Include="../ArenaPickupChecks/HealthDoubles.cs"/>
    <Compile Include="../ArenaPickupChecks/RotationCases.cs"/>
    <Compile Include="../ArenaPickupChecks/AudioChecks.cs"/>
    <Compile Include="../ArenaPickupChecks/AllMapCases.cs"/>
    <Compile Include="../ArenaPickupChecks/FactoryAnchorCases.cs"/>
    <Compile Include="$(MapSource)"/>
    <Compile Include="../../ArenaMode.Shared/ArenaAreaCatalog.cs"/>
    <Compile Include="../../ArenaMode.Shared/ArenaMapCatalog.cs"/>
    <Compile Include="../../ArenaMode.Shared/ArenaBotSpawnPolicy.cs"/>
    <Compile Include="../../ArenaMode.Shared/ArenaTeamBoxCatalog.cs"/>
    <Compile Include="../../ArenaMode.Shared/ArenaEquatorTeamSpawns.cs"/>
    <Compile Include="$(PickupAudioSource)" Link="Production/ArenaPickupAudio.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaHealthPickup.cs" Link="Production/ArenaHealthPickup.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPowerupState.cs" Link="Production/ArenaPowerupState.cs"/>
    <Compile Include="../../ArenaMode.Client/Kits/KitModels.cs" Link="Production/KitModels.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupWeapons.cs" Link="Production/ArenaPickupWeapons.cs"/>
    <Compile Include="$(RuntimeSource)" Link="Production/ArenaPickupRuntime.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupState.cs" Link="Production/ArenaPickupState.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupLayout.cs" Link="Production/ArenaPickupLayout.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupGeometry.cs" Link="Production/ArenaPickupGeometry.cs"/>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../ArenaMode.Client/ArenaAssetPaths.cs" Link="Production/ArenaAssetPaths.cs" />
  </ItemGroup>
</Project>
