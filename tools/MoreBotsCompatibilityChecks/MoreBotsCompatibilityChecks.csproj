<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Contract fixture, never shipped or deployed. -->
    <AssemblyName>MoreBotsPlugin</AssemblyName>
    <MoreBotsSourceRoot Condition="'$(MoreBotsSourceRoot)' == ''">../../ArenaMode.Client/Compat</MoreBotsSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MoreBotsSourceRoot)/ArenaMoreBotsRaidPolicy.cs" Link="Production/ArenaMoreBotsRaidPolicy.cs" />
    <Compile Include="$(MoreBotsSourceRoot)/ArenaMoreBotsCompatibility.cs" Link="Production/ArenaMoreBotsCompatibility.cs" />
    <Compile Include="../../ArenaMode.Shared/Protocol.cs" Link="Production/Protocol.cs" />
    <Compile Include="$(MoreBotsSpawnSource)" Link="Production/OwnedSpawns.cs" Condition="'$(MoreBotsSpawnSource)' != ''" />
  </ItemGroup>
</Project>
