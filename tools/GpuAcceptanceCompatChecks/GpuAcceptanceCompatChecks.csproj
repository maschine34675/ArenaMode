    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <CompatSource Condition="'$(CompatSource)' == ''">../../ArenaMode.Client/Compat/ArenaGpuAcceptanceCompat.cs</CompatSource>
