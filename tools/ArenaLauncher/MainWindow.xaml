<Window x:Class="ArenaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arena Launcher" Width="920" Height="760" MinWidth="700" MinHeight="600"
        AutomationProperties.AutomationId="ArenaLauncher"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource CanvasBrush}">
        <StackPanel x:Name="Page" Margin="32,24,32,24">
            <StackPanel Margin="0,0,0,22">
                <DockPanel>
                    <Border DockPanel.Dock="Right" VerticalAlignment="Top" Background="#28313A"
                            CornerRadius="4" Padding="10,5">
                        <TextBlock x:Name="BuildBadge" Text="PROTOTYPE" FontSize="10" AutomationProperties.AutomationId="ArenaBuildBadge"
                                   AutomationProperties.Name="ArenaLauncher direct-v1"
                                   Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="ArenaMode" FontSize="37" FontWeight="Bold"/>
                </DockPanel>
                <TextBlock Text="Independent mod for SPT. Your regular installation and profile stay separate."
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                <TextBlock Text="Not Escape from Tarkov: Arena. Not affiliated with Battlestate Games."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="01   EXISTING SPT INSTALLATION" Style="{StaticResource Caption}"/>
                    <Grid Margin="0,3,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SourceBox" AutomationProperties.Name="SPT installation folder"
                                 AutomationProperties.AutomationId="ArenaSource"
                                 ToolTip="The folder containing EscapeFromTarkov.exe and SPT_Runtime."/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="_Browse…" Click="Browse_Click" Margin="10,0,0,0"/>
                    </Grid>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="InspectButton" Content="_Check installation" Click="Inspect_Click" DockPanel.Dock="Right" Margin="20,0,0,0"/>
                        <TextBlock Text="Select an installed SPT 4.1 with ArenaMode and Redeploy.Core. No download or mod switching."
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="12"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="02   PRIVATE ARENA ENVIRONMENT" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="DestinationText" Text="Check an installation to see its private Arena folder."
                               AutomationProperties.AutomationId="ArenaDestination"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="PRIVATE COPIES" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="PrivateSizeText" Text="—" FontSize="25" FontWeight="SemiBold"/>
                            <TextBlock Text="Separate programs, DLLs and server data."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="SHARED GAME ASSETS" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="SharedSizeText" Text="—" FontSize="25" FontWeight="SemiBold"/>
                            <TextBlock Text="NTFS hardlinks. Asset data stored only once."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PROFILE" Style="{StaticResource Caption}"/>
                            <TextBlock Text="Arena-Internal" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="No profile imports" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,14,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Text="Shared assets use the same data on disk through two file paths. Explorer may still count their full size in both folders."/>
                    <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Text="Available game settings are copied from normal SPT each launch, replacing Arena's copies. No changes write back."/>
                    <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Text="ArenaMode, Redeploy.Core, audio and kit data update from normal SPT before launch. Other mods stay excluded. Game/SPT updates need a new environment."/>
                    <TextBlock x:Name="UpdateHint" Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource AccentBrush}"
                               Text="Check an installation to see pending mod updates."/>
                    <TextBlock x:Name="EnvironmentHint" Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Text="Catalog sizes, not total disk usage. Caches and logs need additional space."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0" BorderBrush="#4E4B3E">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusHeading" Text="Choose your installation" FontSize="18" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="ArenaStatus"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="StatusDetail" Text="Nothing starts until you click Launch Arena."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button x:Name="StartButton" Grid.Column="1" Content="Launch _Arena" Click="Start_Click" IsEnabled="False"
                                AutomationProperties.AutomationId="ArenaLaunch"
                                Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}"
                                Foreground="#151B21" FontWeight="Bold" MinWidth="180"/>
                    </Grid>
                    <ProgressBar x:Name="Activity" Height="3" Margin="0,15,0,0" IsIndeterminate="False"
                                 Foreground="{StaticResource AccentBrush}" Background="#2C3740" BorderThickness="0"/>
                    <TextBlock x:Name="NoticeText" Visibility="Collapsed" Foreground="#E8C487" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Expander x:Name="LogExpander" Header="Activity log" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"
                      HorizontalContentAlignment="Stretch">
                <TextBox x:Name="ActivityLog" Margin="0,9,0,0" Height="140" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Activity log"/>
            </Expander>
            <TextBlock Text="Keep this window open while playing. Close EFT to end the private session. You can minimize this window."
                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,14,0,0"/>
            <Button Content="Third-party licenses" HorizontalAlignment="Left" Margin="0,12,0,0"
                    AutomationProperties.AutomationId="ArenaLicenses" Click="Licenses_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
