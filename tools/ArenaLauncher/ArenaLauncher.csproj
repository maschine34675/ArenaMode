<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>maschine-ArenaLauncher</AssemblyName>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ArenaStart/ArenaStart.csproj" />
    <EmbeddedResource Include="Notices/*.txt" LogicalName="ArenaLauncher.Notices.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="ArenaLauncher.Notices.ARENA-LICENSE.txt" />
  </ItemGroup>
</Project>
