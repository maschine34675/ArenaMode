<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <!-- The two production files the mutants replace, each overridable. -->
    <GuardSource Condition="'$(GuardSource)'==''">../../ArenaMode.Server/Services/ArenaPresetGuard.cs</GuardSource>
    <GeneratorSource Condition="'$(GeneratorSource)'==''">../../ArenaMode.Server/Services/LadderGenerator.cs</GeneratorSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GuardSource)" Link="Production/ArenaPresetGuard.cs" />
    <Compile Include="$(GeneratorSource)" Link="Production/LadderGenerator.cs" />
    <Compile Include="../../ArenaMode.Server/Services/ArenaWeaponVariants.cs" Link="Production/ArenaWeaponVariants.cs" />
    <Compile Include="../../ArenaMode.Server/Services/ArenaTemplateEligibility.cs" Link="Production/ArenaTemplateEligibility.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaTemplateExclusions.cs" Link="Production/ArenaTemplateExclusions.cs" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.0" />
  </ItemGroup>
</Project>
