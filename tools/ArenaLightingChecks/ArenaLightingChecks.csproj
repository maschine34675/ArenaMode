<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ProductionPolicySource Condition="'$(ProductionPolicySource)' == ''">../../ArenaMode.Client/Effects/ArenaLightingPolicy.cs</ProductionPolicySource>
    <ProductionDirectorSource Condition="'$(ProductionDirectorSource)' == ''">../../ArenaMode.Client/Effects/ArenaLightingDirector.cs</ProductionDirectorSource>
    <ProductionPaletteSource Condition="'$(ProductionPaletteSource)' == ''">../../ArenaMode.Client/Effects/ArenaTracerColor.cs</ProductionPaletteSource>
    <ProductionCueSource Condition="'$(ProductionCueSource)' == ''">../../ArenaMode.Client/Modes/ArenaAnnouncerCue.cs</ProductionCueSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductionPolicySource)" Link="Production/ArenaLightingPolicy.cs" />
    <Compile Include="$(ProductionDirectorSource)" Link="Production/ArenaLightingDirector.cs" />
    <Compile Include="$(ProductionPaletteSource)" Link="Production/ArenaTracerColor.cs" />
    <Compile Include="$(ProductionCueSource)" Link="Production/ArenaAnnouncerCue.cs" />
  </ItemGroup>
</Project>
