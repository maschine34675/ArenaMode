<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ProductionAccessSource Condition="'$(ProductionAccessSource)' == ''">../../ArenaMode.Client/Session/ArenaLabyrinthAccess.cs</ProductionAccessSource>
    <ProductionKeycardSource Condition="'$(ProductionKeycardSource)' == ''">../../ArenaMode.Client/Session/MapAccessPatch.cs</ProductionKeycardSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../DeathmatchMenuChecks/CatalogSeams.cs" Link="CatalogSeams.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaPopulationPolicy.cs" Link="Production/ArenaPopulationPolicy.cs" />
    <Compile Include="../../ArenaMode.Shared/DeathmatchSelection.cs" Link="Production/DeathmatchSelection.cs" />
    <Compile Include="$(ProductionAccessSource)" Link="Production/ArenaLabyrinthAccess.cs" />
    <Compile Include="$(ProductionKeycardSource)" Link="Production/MapAccessPatch.cs" />
    <Compile Include="../../ArenaMode.Client/Session/ArenaMenuSelection.cs" Link="Production/ArenaMenuSelection.cs" />
    <Compile Include="../../ArenaMode.Client/Session/ArenaAreaSelectionState.cs" Link="Production/ArenaAreaSelectionState.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/ArenaModeCatalog.cs" Link="Production/ArenaModeCatalog.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaAreaCatalog.cs" Link="Production/ArenaAreaCatalog.cs" />
    <Compile Include="../../ArenaMode.Client/Session/ArenaClaim.cs" Link="Production/ArenaClaim.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaMapCatalog.cs" Link="Production/ArenaMapCatalog.cs" />
  </ItemGroup>
</Project>
