<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings>
    <ClockSource Condition="'$(ClockSource)' == ''">../../ArenaMode.Shared/ArenaDifficultyClock.cs</ClockSource>
    <PressureSource Condition="'$(PressureSource)' == ''">../../ArenaMode.Client/Bots/ArenaPressure.cs</PressureSource>
    <DemandSource Condition="'$(DemandSource)' == ''">../../ArenaMode.Client/Bots/ArenaBotDifficultyClockPatch.cs</DemandSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ArenaBalanceFixtures.cs" Link="Fixtures.cs" />
    <Compile Include="$(ClockSource)" Link="Production/ArenaDifficultyClock.cs" />
    <Compile Include="$(PressureSource)" Link="Production/ArenaPressure.cs" />
    <Compile Include="$(DemandSource)" Link="Production/ArenaBotDifficultyClockPatch.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
