<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PreviewFlowSource Condition="'$(PreviewFlowSource)' == ''">../../ArenaMode.Client/Session/Preview/ArenaPreviewFlow.cs</PreviewFlowSource>
    <PreviewStateSource Condition="'$(PreviewStateSource)' == ''">../../ArenaMode.Client/Session/Preview/ArenaPreviewLifetimeState.cs</PreviewStateSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="BoundaryDoubles.cs" />
    <Compile Include="$(PreviewAdapterSource)" Link="Production/PreviewAdapter.cs" />
    <Compile Include="$(PreviewFlowSource)" Link="Production/ArenaPreviewFlow.cs" />
    <Compile Include="$(PreviewStateSource)" Link="Production/ArenaPreviewLifetimeState.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/ZombieOwnGearGate.cs" Link="Production/ZombieOwnGearGate.cs" />
  </ItemGroup>
</Project>
