<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PickupSourceRoot Condition="'$(PickupSourceRoot)' == ''">../../ArenaMode.Client/Pickups</PickupSourceRoot>
    <PickupAudioSource Condition="'$(PickupAudioSource)' == ''">../../ArenaMode.Client/Pickups/ArenaPickupAudio.cs</PickupAudioSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="Program.cs"/><Compile Include="Doubles.cs"/>
    <Compile Include="HealthDoubles.cs"/>
    <Compile Include="RotationCases.cs"/>
    <Compile Include="AudioChecks.cs"/>
    <Compile Include="AllMapCases.cs"/>
    <Compile Include="FactoryAnchorCases.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupMapLayout.cs"/>
    <Compile Include="../../ArenaMode.Shared/ArenaAreaCatalog.cs"/>
    <Compile Include="../../ArenaMode.Shared/ArenaMapCatalog.cs"/>
    <Compile Include="../../ArenaMode.Shared/ArenaBotSpawnPolicy.cs"/>
    <Compile Include="../../ArenaMode.Shared/ArenaTeamBoxCatalog.cs"/>
    <Compile Include="../../ArenaMode.Shared/ArenaEquatorTeamSpawns.cs"/>
    <Compile Include="$(PickupAudioSource)" Link="Production/ArenaPickupAudio.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaHealthPickup.cs" Link="Production/ArenaHealthPickup.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPowerupState.cs" Link="Production/ArenaPowerupState.cs"/>
    <Compile Include="../../ArenaMode.Client/Kits/KitModels.cs" Link="Production/KitModels.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupWeapons.cs" Link="Production/ArenaPickupWeapons.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupRuntime.cs" Link="Production/ArenaPickupRuntime.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupState.cs" Link="Production/ArenaPickupState.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupLayout.cs" Link="Production/ArenaPickupLayout.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupGeometry.cs" Link="Production/ArenaPickupGeometry.cs"/>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../ArenaMode.Client/ArenaAssetPaths.cs" Link="Production/ArenaAssetPaths.cs" />
  </ItemGroup>
</Project>
