<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AreaCatalogSource Condition="'$(AreaCatalogSource)' == ''">../../ArenaMode.Shared/ArenaAreaCatalog.cs</AreaCatalogSource>
    <AreaSelectionStateSource Condition="'$(AreaSelectionStateSource)' == ''">../../ArenaMode.Client/Session/ArenaAreaSelectionState.cs</AreaSelectionStateSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../DeathmatchMenuChecks/CatalogSeams.cs" Link="CatalogSeams.cs" />
    <Compile Include="$(AreaCatalogSource)" Link="Production/ArenaAreaCatalog.cs" />
    <Compile Include="$(AreaSelectionStateSource)" Link="Production/ArenaAreaSelectionState.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaMapCatalog.cs" Link="Production/ArenaMapCatalog.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaBotSpawnPolicy.cs" Link="Production/ArenaBotSpawnPolicy.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaPopulationPolicy.cs" Link="Production/ArenaPopulationPolicy.cs" />
    <Compile Include="../../ArenaMode.Shared/DeathmatchSelection.cs" Link="Production/DeathmatchSelection.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/ArenaModeCatalog.cs" Link="Production/ArenaModeCatalog.cs" />
  </ItemGroup>
</Project>
