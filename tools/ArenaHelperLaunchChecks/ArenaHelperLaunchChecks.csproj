<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
    <LauncherSource Condition="'$(LauncherSource)' == ''">../../ArenaMode.Client/Session/ArenaHelperProcess.cs</LauncherSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(LauncherSource)" Link="Production/ArenaHelperProcess.cs" />
    <Compile Include="../../ArenaMode.Session/SessionLogic.cs" Link="Production/SessionLogic.cs" />
    <Compile Include="../../ArenaMode.Shared/Session/*.cs" Link="Production/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
