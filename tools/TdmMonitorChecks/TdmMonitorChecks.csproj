<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <MonitorBinderSource Condition="'$(MonitorBinderSource)' == ''">../../ArenaMode.Client/Compat/ArenaMapPortScoreMonitors.cs</MonitorBinderSource>
    <MonitorMapperSource Condition="'$(MonitorMapperSource)' == ''">../../ArenaMode.Client/Modes/TeamDeathmatchMonitors.cs</MonitorMapperSource>
    <MonitorRuntimeSource Condition="'$(MonitorRuntimeSource)' == ''">../../ArenaMode.Client/Modes/TeamDeathmatchMode.Monitors.cs</MonitorRuntimeSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MonitorBinderSource)" Link="Production/ArenaMapPortScoreMonitors.cs" />
    <Compile Include="$(MonitorMapperSource)" Link="Production/TeamDeathmatchMonitors.cs" />
    <Compile Include="$(MonitorRuntimeSource)" Link="Production/TeamDeathmatchMode.Monitors.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/TeamDeathmatchMatchPolicy.cs" Link="Production/TeamDeathmatchMatchPolicy.cs" />
  </ItemGroup>
</Project>
