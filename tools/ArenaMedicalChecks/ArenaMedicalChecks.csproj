<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ProductionTimingSource Condition="'$(ProductionTimingSource)' == ''">../../ArenaMode.Client/Combat/ArenaMedicalTiming.cs</ProductionTimingSource>
    <ProductionPatchSource Condition="'$(ProductionPatchSource)' == ''">../../ArenaMode.Client/Combat/ArenaMedicalPatches.cs</ProductionPatchSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductionTimingSource)" Link="Production/ArenaMedicalTiming.cs" />
    <Compile Include="$(ProductionPatchSource)" Link="Production/ArenaMedicalPatches.cs" />
  </ItemGroup>
</Project>
