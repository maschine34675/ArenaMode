<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ColaCatalogSource Condition="'$(ColaCatalogSource)' == ''">../../ArenaMode.Shared/TarkovaColaResearchCatalog.cs</ColaCatalogSource>
    <ColaAdapterSource Condition="'$(ARENA_COLA_ADAPTER_SOURCE)' != ''">$(ARENA_COLA_ADAPTER_SOURCE)</ColaAdapterSource>
    <ColaAdapterSource Condition="'$(ColaAdapterSource)' == ''">$(MSBuildThisFileDirectory)..\..\ArenaMode.Client\Compat\ArenaTarkovaColaCompat.cs</ColaAdapterSource>
    <SPTPath Condition="'$(SPTPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\</SPTPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)ColaLifecycle.generated.cs" />
    <Compile Include="$(ColaCatalogSource)" Link="Production/TarkovaColaResearchCatalog.cs" />
    <Compile Include="../../ArenaMode.Shared/TarkovaColaPolicy.cs" Link="Production/TarkovaColaPolicy.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(SPTPath)/EscapeFromTarkov_Data/Managed/Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(SPTPath)/BepInEx/core/Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="ExtractColaLifecycle" BeforeTargets="CoreCompile">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)Extract-Lifecycle.ps1&quot; -Source &quot;$(ColaAdapterSource)&quot; -Destination &quot;$(IntermediateOutputPath)ColaLifecycle.generated.cs&quot;" />
  </Target>
</Project>
