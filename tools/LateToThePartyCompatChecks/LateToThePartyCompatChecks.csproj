<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <ProductionRoot Condition="'$(ProductionRoot)' == ''">../../ArenaMode.Client/Compat</ProductionRoot>
    <PickupSource Condition="'$(PickupSource)' == ''">../../ArenaMode.Client/Pickups/ArenaWeaponPickup.cs</PickupSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductionRoot)/ArenaLateToThePartyCompat.cs" Link="Production/Compat.cs" />
    <Compile Include="$(ProductionRoot)/ArenaLateToThePartyScope.cs" Link="Production/Scope.cs" />
    <Compile Include="$(ProductionRoot)/ArenaLateToThePartyContract.cs" Link="Production/Contract.cs" />
    <Compile Include="$(PickupSource)" Link="Production/Pickup.cs" />
    <Reference Include="Mono.Cecil"><HintPath>../../../../BepInEx/core/Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
</Project>
