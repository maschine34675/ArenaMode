<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RewardTransferSource Condition="'$(RewardTransferSource)' == ''">../../ArenaMode.Session/RewardTransfer.cs</RewardTransferSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RewardTransferSource)" Link="Production/RewardTransfer.cs" />
    <Compile Include="../../ArenaMode.Session/SessionLogic.cs" Link="Production/SessionLogic.cs" />
    <Compile Include="../../ArenaMode.Session/SessionFileSystem.cs" Link="Production/SessionFileSystem.cs" />
    <Compile Include="../../ArenaMode.Session/HelperRunner.cs" Link="Production/HelperRunner.cs" />
    <Compile Include="../../ArenaMode.Session/HelperProcesses.cs" Link="Production/HelperProcesses.cs" />
    <Compile Include="../../ArenaMode.Session/HelperLog.cs" Link="Production/HelperLog.cs" />
    <Compile Include="../../ArenaMode.Shared/Session/ArenaMiniJson.cs" Link="Production/ArenaMiniJson.cs" />
    <Compile Include="../../ArenaMode.Shared/Session/ArenaWhitelistPolicy.cs" Link="Production/ArenaWhitelistPolicy.cs" />
    <Compile Include="../../ArenaMode.Shared/Session/ArenaWhitelistDecision.cs" Link="Production/ArenaWhitelistDecision.cs" />
    <Compile Include="../../ArenaMode.Shared/Session/ArenaSessionContract.cs" Link="Production/ArenaSessionContract.cs" />
  </ItemGroup>
</Project>
