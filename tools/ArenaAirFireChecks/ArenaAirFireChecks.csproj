<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <AirFireSource Condition="'$(AirFireSource)' == ''">../../ArenaMode.Client/Movement/ArenaAirFire.cs</AirFireSource>
    <ScopeSource Condition="'$(ScopeSource)' == ''">../../ArenaMode.Client/Movement/ArenaMovementScope.cs</ScopeSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AirFireSource)" Link="Production/ArenaAirFire.cs" />
    <Compile Include="$(ScopeSource)" Link="Production/ArenaMovementScope.cs" />
  </ItemGroup>
</Project>
