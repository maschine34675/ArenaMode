<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <FragmentsRoot Condition="'$(FragmentsRoot)' == ''">$(MSBuildThisFileDirectory)evidence/current</FragmentsRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Spies.cs" />
    <Compile Include="$(FragmentsRoot)/ArenaBotPatches.cs" />
    <Compile Include="$(FragmentsRoot)/BotZoneGroups.cs" />
    <Compile Include="$(FragmentsRoot)/BotZoneGroupsDictionary.cs" />
  </ItemGroup>
</Project>
