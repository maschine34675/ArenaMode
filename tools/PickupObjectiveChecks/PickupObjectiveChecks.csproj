    <Compile Include="../ArenaPickupChecks/RotationCases.cs"/>
    <Compile Include="../ArenaPickupChecks/AudioChecks.cs"/>
    <Compile Include="../ArenaPickupChecks/AllMapCases.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupMapLayout.cs"/>
    <Compile Include="../../ArenaMode.Shared/ArenaAreaCatalog.cs"/>
    <Compile Include="../../ArenaMode.Shared/ArenaMapCatalog.cs"/>
    <Compile Include="../../ArenaMode.Shared/ArenaBotSpawnPolicy.cs"/>
