    <DefineConstants>PICKUP_OBJECTIVES</DefineConstants>
    <PickupSourceRoot Condition="'$(PickupSourceRoot)' == ''">../../ArenaMode.Client/Pickups</PickupSourceRoot>
    <ObjectiveSourceRoot Condition="'$(ObjectiveSourceRoot)' == ''">../../ArenaMode.BigBrainCompat</ObjectiveSourceRoot>
