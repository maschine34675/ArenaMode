    <Compile Include="$(PickupSourceRoot)/ArenaPickupRuntime.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupState.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupLayout.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupGeometry.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaHealthPickup.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPowerupState.cs"/>
    <Compile Include="$(PickupSourceRoot)/ArenaPickupTargets.cs"/>
    <Compile Include="$(ObjectiveSourceRoot)/ArenaPickupObjective.cs"/>
    <Compile Include="$(ObjectiveSourceRoot)/ArenaPickupLayer.cs"/>
    <Compile Include="$(ObjectiveSourceRoot)/ArenaPickupLogic.cs"/>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../ArenaMode.Client/ArenaAssetPaths.cs" Link="Production/ArenaAssetPaths.cs" />
  </ItemGroup>
