<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SoloSourceRoot Condition="'$(SoloSourceRoot)' == ''">../../ArenaMode.Client/Bots</SoloSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" /><Compile Include="Stubs.cs" />
    <Compile Include="$(SoloSourceRoot)/ArenaSoloPopulation.cs" Link="Production/ArenaSoloPopulation.cs" />
    <Compile Include="$(SoloSourceRoot)/ArenaSoloPopulationPolicy.cs" Link="Production/ArenaSoloPopulationPolicy.cs" />
    <Compile Include="$(SoloSourceRoot)/ArenaSoloSpawnDispatch.cs" Link="Production/ArenaSoloSpawnDispatch.cs" />
    <Compile Include="$(SoloSourceRoot)/ArenaBotSpawnPatches.cs" Link="Production/ArenaBotSpawnPatches.cs" />
    <Compile Include="$(ExtractedBurstSource)" Link="Production/ManagedBurst.cs" />
  </ItemGroup>
</Project>
