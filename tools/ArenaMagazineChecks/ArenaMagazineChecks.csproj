<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ProductionTimingSource Condition="'$(ProductionTimingSource)' == ''">../../ArenaMode.Client/Combat/ArenaMagazineTiming.cs</ProductionTimingSource>
    <ProductionPatchSource Condition="'$(ProductionPatchSource)' == ''">../../ArenaMode.Client/Combat/ArenaMagazinePatches.cs</ProductionPatchSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductionTimingSource)" Link="Production/ArenaMagazineTiming.cs" />
    <Compile Include="$(ProductionPatchSource)" Link="Production/ArenaMagazinePatches.cs" />
    <Reference Include="Mono.Cecil">
      <HintPath>../../../../BepInEx/core/Mono.Cecil.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
