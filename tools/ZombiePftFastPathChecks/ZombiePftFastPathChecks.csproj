<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable><LangVersion>latest</LangVersion>
    <AssemblyVersion>0.10.3.0</AssemblyVersion>
    <FastPathSource Condition="'$(FastPathSource)' == ''">../../ArenaMode.Client/Compat/ZombiePftFastPath.cs</FastPathSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="evidence/**/*.cs" />
    <Compile Include="$(FastPathSource)" Link="Production/ZombiePftFastPath.cs" />
    <Compile Include="../../ArenaMode.Shared/PitFireTeamVersions.cs" Link="Production/PitFireTeamVersions.cs" />
  </ItemGroup>
</Project>
