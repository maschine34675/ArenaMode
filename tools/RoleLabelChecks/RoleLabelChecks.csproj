<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RoleSource Condition="'$(RoleSource)' == ''">$(MSBuildThisFileDirectory)..\..\ArenaMode.Client\Combat\RoleClassifier.cs</RoleSource>
    <NativeSourceRoot Condition="'$(NativeSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\_decompiled</NativeSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RoleSource)" Link="Production/RoleClassifier.cs" />
    <Compile Include="../../ArenaMode.Client/Combat/ScoreRules.cs" Link="Production/ScoreRules.cs" />
    <Compile Include="../../ArenaMode.Client/Combat/ArenaKill.cs" Link="Production/ArenaKill.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/ArenaScoreboard.cs" Link="Production/ArenaScoreboard.cs" />
    <!-- Compile native enum/default contracts, without loading EFT/Unity binaries. -->
    <Compile Include="$(NativeSourceRoot)/EFT/EPlayerSide.cs" Link="Native/EPlayerSide.cs" />
    <Compile Include="$(NativeSourceRoot)/EFT/WildSpawnType.cs" Link="Native/WildSpawnType.cs" />
    <Compile Include="$(NativeSourceRoot)/BotDifficulty.cs" Link="Native/BotDifficulty.cs" />
    <Compile Include="$(NativeSourceRoot)/EFT/ProfileSettings.cs" Link="Native/ProfileSettings.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../ArenaMode.Client/Combat/ArenaShotAwardHistory.cs" Link="Production/ArenaShotAwardHistory.cs" />
  </ItemGroup>
</Project>
