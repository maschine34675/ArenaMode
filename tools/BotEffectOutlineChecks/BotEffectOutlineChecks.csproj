<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EffectSourceRoot Condition="'$(EffectSourceRoot)' == ''">../../ArenaMode.Client/Effects</EffectSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;Doubles.cs" />
    <Compile Include="$(EffectSourceRoot)/ArenaBotEffectLeases.cs;$(EffectSourceRoot)/ArenaBotEffectRenderer.cs;$(EffectSourceRoot)/ArenaSpawnShieldView.cs;$(EffectSourceRoot)/ArenaPowerupIndicator.cs" Link="Production/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../ArenaMode.Client/Assets/BotEffects/bot-effect-outlines.bundle" LogicalName="ArenaMode.BotEffects.bot-effect-outlines.bundle" />
  </ItemGroup>
</Project>
