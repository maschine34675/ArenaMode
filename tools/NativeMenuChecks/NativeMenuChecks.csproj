<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <SPTPath Condition="'$(SPTPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\</SPTPath>
    <ProductionServerClientSource Condition="'$(ProductionServerClientSource)' == ''">../../ArenaMode.Client/Session/ArenaServerClient.cs</ProductionServerClientSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ArenaMode.Client/Session/ArenaMenuSelection.cs" Link="Production/ArenaMenuSelection.cs" />
    <Compile Include="$(ProductionServerClientSource)" Link="Production/ArenaServerClient.cs" />
    <Compile Include="../../ArenaMode.Client/Session/LocalRaidStartedPatch.cs" Link="Production/LocalRaidStartedPatch.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/ArenaModeCatalog.cs" Link="Production/ArenaModeCatalog.cs" />
    <Compile Include="../../ArenaMode.Shared/Protocol.cs" Link="Production/Protocol.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaMapCatalog.cs" Link="Production/ArenaMapCatalog.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaAreaCatalog.cs" Link="Production/ArenaAreaCatalog.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SPTPath)/EscapeFromTarkov_Data/Managed/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
