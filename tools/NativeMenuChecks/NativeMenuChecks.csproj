<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <SPTPath Condition="'$(SPTPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\</SPTPath>
    <ProductionServerClientSource Condition="'$(ProductionServerClientSource)' == ''">../../ArenaMode.Client/Session/ArenaServerClient.cs</ProductionServerClientSource>
    <ProductionConditionalMapSource Condition="'$(ProductionConditionalMapSource)' == ''">../../ArenaMode.Client/Session/ArenaConditionalMapView.cs</ProductionConditionalMapSource>
    <ProductionAreaCatalogSource Condition="'$(ProductionAreaCatalogSource)' == ''">../../ArenaMode.Shared/ArenaAreaCatalog.cs</ProductionAreaCatalogSource>
    <ProductionMenuSelectionSource Condition="'$(ProductionMenuSelectionSource)' == ''">../../ArenaMode.Client/Session/ArenaMenuSelection.cs</ProductionMenuSelectionSource>
    <ProductionLocalStartSource Condition="'$(ProductionLocalStartSource)' == ''">../../ArenaMode.Client/Session/LocalRaidStartedPatch.cs</ProductionLocalStartSource>
    <ProductionSessionModeCaptionSource Condition="'$(ProductionSessionModeCaptionSource)' == ''">../../ArenaMode.Client/Session/ArenaSessionModeCaption.cs</ProductionSessionModeCaptionSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../EquatorMapChecks/PluginStubs.cs" Link="PluginStubs.cs" />
    <Compile Include="../DeathmatchMenuChecks/CatalogSeams.cs" Link="CatalogSeams.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaPopulationPolicy.cs" Link="Production/ArenaPopulationPolicy.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaParticipantPolicy.cs" Link="Production/ArenaParticipantPolicy.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/DeathmatchRules.cs" Link="Production/DeathmatchRules.cs" />
    <Compile Include="../../ArenaMode.Shared/DeathmatchSelection.cs" Link="Production/DeathmatchSelection.cs" />
    <Compile Include="$(ProductionMenuSelectionSource)" Link="Production/ArenaMenuSelection.cs" />
    <Compile Include="../../ArenaMode.Client/Session/ArenaAreaSelectionState.cs" Link="Production/ArenaAreaSelectionState.cs" />
    <Compile Include="$(ProductionConditionalMapSource)" Link="Production/ArenaConditionalMapView.cs" />
    <Compile Include="$(ProductionServerClientSource)" Link="Production/ArenaServerClient.cs" />
    <Compile Include="$(ProductionLocalStartSource)" Link="Production/LocalRaidStartedPatch.cs" />
    <Compile Include="$(ProductionSessionModeCaptionSource)" Link="Production/ArenaSessionModeCaption.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/ArenaModeCatalog.cs" Link="Production/ArenaModeCatalog.cs" />
    <Compile Include="../../ArenaMode.Client/Session/ArenaModeSelectionState.cs" Link="Production/ArenaModeSelectionState.cs" />
    <Compile Include="../../ArenaMode.Client/Compat/PitFireTeamSelectionPolicy.cs" Link="Production/PitFireTeamSelectionPolicy.cs" />
    <Compile Include="../../ArenaMode.Shared/PitFireTeamVersions.cs" Link="Production/PitFireTeamVersions.cs" />
    <Compile Include="../../ArenaMode.Shared/Protocol.cs" Link="Production/Protocol.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaMapCatalog.cs" Link="Production/ArenaMapCatalog.cs" />
    <Compile Include="$(ProductionAreaCatalogSource)" Link="Production/ArenaAreaCatalog.cs" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SPTPath)/EscapeFromTarkov_Data/Managed/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
