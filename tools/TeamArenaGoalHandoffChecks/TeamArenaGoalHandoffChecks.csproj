<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Independent test double, never an installed PFT binary or deployable mod. -->
    <AssemblyName>pitFireTeam</AssemblyName>
    <AssemblyVersion>0.10.0.0</AssemblyVersion>
    <HandoffSource Condition="'$(HandoffSource)' == ''">../../ArenaMode.Client/Bots/TeamArenaGoalHandoff.cs</HandoffSource>
    <ContextSource Condition="'$(ContextSource)' == ''">../../ArenaMode.Client/Compat/PitFireTeamGoalContext.cs</ContextSource>
    <RoundSource Condition="'$(RoundSource)' == ''">../../ArenaMode.Client/Modes/TacticalMode.Pursuit.cs</RoundSource>
    <DiagnosticsSource Condition="'$(DiagnosticsSource)' == ''">../../ArenaMode.Client/Bots/TeamArenaAwarenessDiagnostics.cs</DiagnosticsSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ArenaMode.Shared/PitFireTeamVersions.cs" Link="Production/PitFireTeamVersions.cs" />
    <Compile Include="$(HandoffSource)" Link="Production/TeamArenaGoalHandoff.cs" />
    <Compile Include="$(ContextSource)" Link="Production/PitFireTeamGoalContext.cs" />
    <Compile Include="$(RoundSource)" Link="Production/TacticalMode.Pursuit.cs" />
    <Compile Include="$(DiagnosticsSource)" Link="Production/TeamArenaAwarenessDiagnostics.cs" />
    <Compile Include="../../ArenaMode.Client/Bots/TeamArenaEnemyIdentityPolicy.cs" Link="Production/TeamArenaEnemyIdentityPolicy.cs" />
    <Compile Include="../../ArenaMode.BigBrainCompat/ArenaPursuitRuntime.cs" Link="Production/ArenaPursuitRuntime.cs" />
  </ItemGroup>
</Project>
