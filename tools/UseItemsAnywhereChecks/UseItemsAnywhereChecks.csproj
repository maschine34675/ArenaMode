<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SptRoot Condition="'$(SptRoot)' == ''">../../../..</SptRoot>
    <ReloadSource Condition="'$(ReloadSource)' == ''">../../ArenaMode.Client/Kits/ArenaBackpackReload.cs</ReloadSource>
    <ReachSource Condition="'$(ReachSource)' == ''">../../ArenaMode.Client/Kits/ArenaReachPatches.cs</ReachSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;RuntimeDoubles.cs"/>
    <Compile Include="$(ReloadSource)" Link="Production/ArenaBackpackReload.cs"/>
    <Compile Include="$(ReachSource)" Link="Production/ArenaReachPatches.cs"/>
    <Compile Include="../../ArenaMode.Client/Compat/UseItemsAnywhere/*.cs" Link="Production/%(Filename)%(Extension)"/>
    <Reference Include="0Harmony"><HintPath>$(SptRoot)/BepInEx/core/0Harmony.dll</HintPath></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(SptRoot)/BepInEx/core/Mono.Cecil.dll</HintPath></Reference>
    <Reference Include="MonoMod.RuntimeDetour"><HintPath>$(SptRoot)/BepInEx/core/MonoMod.RuntimeDetour.dll</HintPath></Reference>
    <Reference Include="MonoMod.Utils"><HintPath>$(SptRoot)/BepInEx/core/MonoMod.Utils.dll</HintPath></Reference>
  </ItemGroup>
</Project>
