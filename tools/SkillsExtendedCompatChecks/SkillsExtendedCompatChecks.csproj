<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ProductionRoot Condition="'$(ProductionRoot)' == ''">../../ArenaMode.Client/Compat</ProductionRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductionRoot)/ArenaSkillsExtendedCompat.cs" Link="Production/Compat.cs" />
    <Compile Include="$(ProductionRoot)/ArenaSkillsExtendedContract.cs" Link="Production/Contract.cs" />
    <Compile Include="$(ProductionRoot)/ArenaSkillsExtendedScope.cs" Link="Production/Scope.cs" />
    <Compile Include="../../ArenaMode.Shared/Protocol.cs" Link="Production/Protocol.cs" />
    <Reference Include="Mono.Cecil"><HintPath>../../../../BepInEx/core/Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
</Project>
