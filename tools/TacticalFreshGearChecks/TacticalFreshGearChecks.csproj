<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings>
    <!-- Every production file the checks compile or read is a property so a mutant can point the build at a copy. -->
    <PatchSource Condition="'$(PatchSource)' == ''">../../ArenaMode.Client/Bots/ArenaTacticalFreshGearPatch.cs</PatchSource>
    <StateSource Condition="'$(StateSource)' == ''">../../ArenaMode.Client/Bots/ArenaTacticalOpening.cs</StateSource>
    <GateSource Condition="'$(GateSource)' == ''">../../ArenaMode.Client/Modes/TacticalOpeningBandGate.cs</GateSource>
    <PolicySource Condition="'$(PolicySource)' == ''">../../ArenaMode.Shared/ArenaDifficultyPolicy.cs</PolicySource>
    <DifficultySource Condition="'$(DifficultySource)' == ''">../../ArenaMode.Client/Bots/ArenaDifficulty.cs</DifficultySource>
    <PluginText Condition="'$(PluginText)' == ''">$(MSBuildThisFileDirectory)../../ArenaMode.Client/Plugin.cs</PluginText>
    <DriverText Condition="'$(DriverText)' == ''">$(MSBuildThisFileDirectory)../../ArenaMode.Client/Respawn/ArenaRespawnDriver.cs</DriverText>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ArenaBalanceFixtures.cs" Link="Fixtures.cs" />
    <Compile Include="$(PolicySource)" Link="Production/ArenaDifficultyPolicy.cs" />
    <Compile Include="$(DifficultySource)" Link="Production/ArenaDifficulty.cs" />
    <Compile Include="$(GateSource)" Link="Production/TacticalOpeningBandGate.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/TacticalRoundReply.cs" Link="Production/TacticalRoundReply.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/TacticalOpeningText.cs" Link="Production/TacticalOpeningText.cs" />
    <Compile Include="../../ArenaMode.Shared/Protocol.cs" Link="Production/Protocol.cs" />
    <Compile Include="$(StateSource)" Link="Production/ArenaTacticalOpening.cs" />
    <Compile Include="$(PatchSource)" Link="Production/ArenaTacticalFreshGearPatch.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="PluginText" Value="$([System.IO.Path]::GetFullPath('$(PluginText)'))" />
    <AssemblyMetadata Include="DriverText" Value="$([System.IO.Path]::GetFullPath('$(DriverText)'))" />
  </ItemGroup>
</Project>
