<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ShotSourceRoot Condition="'$(ShotSourceRoot)' == ''">../../ArenaMode.Client/Combat</ShotSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="CollateralChecks.cs" />
    <Compile Include="Doubles.cs" />
    <Compile Include="$(ShotSourceRoot)/ArenaShotAwardHooks.cs" Link="Production/ArenaShotAwardHooks.cs" />
    <Compile Include="$(ShotSourceRoot)/ArenaShotAwardHistory.cs" Link="Production/ArenaShotAwardHistory.cs" />
    <Compile Include="$(ShotSourceRoot)/ArenaHitHistory.cs" Link="Production/ArenaHitHistory.cs" />
  </ItemGroup>
</Project>
