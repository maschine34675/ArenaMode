<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ProjectionSource Condition="'$(ProjectionSource)' == ''">../../ArenaMode.Client/Session/Maps/ArenaAreaMapProjection.cs</ProjectionSource>
    <GraphicSource Condition="'$(GraphicSource)' == ''">../../ArenaMode.Client/Session/Maps/ArenaAreaMapGraphic.cs</GraphicSource>
    <PreviewSource Condition="'$(PreviewSource)' == ''">../../ArenaMode.Client/Session/Maps/ArenaAreaMapPreview.cs</PreviewSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="UnityDoubles.cs" />
    <Compile Include="../DeathmatchMenuChecks/CatalogSeams.cs" Link="CatalogSeams.cs" />
    <Compile Include="$(ProjectionSource)" Link="Production/ArenaAreaMapProjection.cs" />
    <Compile Include="$(GraphicSource)" Link="Production/ArenaAreaMapGraphic.cs" />
    <Compile Include="$(PreviewSource)" Link="Production/ArenaAreaMapPreview.cs" />
    <Compile Include="../../ArenaMode.Client/Session/ArenaAreaSelectionState.cs" Link="Production/ArenaAreaSelectionState.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaAreaCatalog.cs" Link="Production/ArenaAreaCatalog.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaMapCatalog.cs" Link="Production/ArenaMapCatalog.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaPopulationPolicy.cs" Link="Production/ArenaPopulationPolicy.cs" />
    <Compile Include="../../ArenaMode.Shared/DeathmatchSelection.cs" Link="Production/DeathmatchSelection.cs" />
    <Compile Include="../../ArenaMode.Client/Modes/ArenaModeCatalog.cs" Link="Production/ArenaModeCatalog.cs" />
    <EmbeddedResource Include="../../ArenaMode.Client/Assets/MapPreviews/customs-ground.png" LogicalName="ArenaMode.MapPreviews.customs-ground.png" />
  </ItemGroup>
</Project>
