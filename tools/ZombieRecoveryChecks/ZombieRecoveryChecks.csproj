<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <RecoverySource Condition="'$(RecoverySource)' == ''">../../ArenaMode.Client/Bots/ZombieRecoveryRuntime.cs</RecoverySource>
    <WaveSource Condition="'$(WaveSource)' == ''">../../ArenaMode.Client/Modes/ZombieWavePolicy.cs</WaveSource>
    <ServiceSource Condition="'$(ServiceSource)' == ''">../../ArenaMode.Client/Bots/ZombieSpawnService.cs</ServiceSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RecoverySource)" Link="Production/ZombieRecoveryRuntime.cs" />
    <Compile Include="$(WaveSource)" Link="Production/ZombieWavePolicy.cs" />
    <Compile Include="$(ServiceSource)" Link="Production/ZombieSpawnService.cs" />
  </ItemGroup>
</Project>
