<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <ConnectivitySource Condition="'$(ConnectivitySource)' == ''">../../ArenaMode.Client/Areas/ArenaAreaConnectivityGraph.cs</ConnectivitySource>
    <AdapterSource Condition="'$(AdapterSource)' == ''">../../ArenaMode.Client/Areas/ArenaAreaConnectivityRuntime.cs</AdapterSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ConnectivitySource)" Link="Production/ArenaAreaConnectivityGraph.cs" />
    <Compile Include="$(AdapterSource)" Link="Production/ArenaAreaConnectivityRuntime.cs" />
  </ItemGroup>
</Project>
