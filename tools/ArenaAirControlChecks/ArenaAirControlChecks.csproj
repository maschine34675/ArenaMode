<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AirControlSource Condition="'$(AirControlSource)' == ''">../../ArenaMode.Client/Movement/ArenaAirControl.cs</AirControlSource>
    <MovementScopeSource Condition="'$(MovementScopeSource)' == ''">../../ArenaMode.Client/Movement/ArenaMovementScope.cs</MovementScopeSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AirControlSource)" Link="Production/ArenaAirControl.cs" />
    <Compile Include="$(MovementScopeSource)" Link="Production/ArenaMovementScope.cs" />
  </ItemGroup>
</Project>
