<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <VoiceSource Condition="'$(VoiceSource)' == ''">../../ArenaMode.Client/Audio/ArenaPmcVoice.cs</VoiceSource>
    <PolicySource Condition="'$(PolicySource)' == ''">../../ArenaMode.Client/Audio/ArenaPmcVoicePolicy.cs</PolicySource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(VoiceSource)" Link="Production/ArenaPmcVoice.cs" />
    <Compile Include="$(PolicySource)" Link="Production/ArenaPmcVoicePolicy.cs" />
  </ItemGroup>
</Project>
