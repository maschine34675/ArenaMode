{
  "name": "chopshop-zombie",
  "description": "Chop Shop solo Zombies under godmode (an idle player dies within half a minute), with the player in the yard centre from the start: until ArenaMapPort's rows of 2026-11-12 no Bot row lay beyond the 25 m floor there and every request was dropped. The first wave has to fill from the centre without a dropped request, and again after the player moved to a pocket. No errors.",
  "host": "host2",
  "steps": [
    {"step": "status", "name": "status"},
    {"step": "raid", "name": "raid", "mode": "zombie", "map": "CHOP SHOP", "mapFromMenu": true, "timeoutSeconds": 480},
    {"step": "hook", "name": "godmode", "action": "godmode", "enabled": true},
    {"step": "teleport", "name": "to-centre", "x": -379, "y": -3.79, "z": 495, "reachable": false},
    {"step": "sleep", "name": "first-wave", "seconds": 35},
    {"step": "player", "name": "player-centre"},
    {"step": "bots", "name": "infected-centre", "aliveOnly": true, "minCount": 20},
    {"step": "expect", "name": "no-dropped-spawn", "what": "logAbsent", "contains": "no usable spawn point", "sinceStep": "raid"},
    {"step": "teleport", "name": "to-pocket", "x": -337.278, "y": -3.8, "z": 502.69, "reachable": false},
    {"step": "sleep", "name": "pocket", "seconds": 20},
    {"step": "bots", "name": "infected-pocket", "aliveOnly": true, "minCount": 20, "onFail": "continue"},
    {"step": "expect", "name": "no-dropped-spawn-pocket", "what": "logAbsent", "contains": "no usable spawn point", "sinceStep": "raid"},
    {"step": "still", "name": "still", "id": "zombie-pocket"},
    {"step": "expect", "what": "logAbsent", "level": "error", "sinceStep": "raid", "onFail": "continue"},
    {"step": "log-export", "name": "export", "onFail": "continue"}
  ],
  "finally": [
    {"step": "hook", "name": "godmode-off", "action": "godmode", "enabled": false, "onFail": "continue"},
    {"step": "leave", "whenStepStarted": "raid"}
  ]
}
