{
  "name": "block-tdm",
  "description": "Block Team Deathmatch in the original TeamFight pockets (USEC south on the platform, BEAR north in the room): markers restored, formation ready, gates held then opened with all twenty paths revalidated, both factions alive, the routes from the field to both capture points and to the donor row, player death and respawn into the pocket.",
  "host": "host2",
  "parameters": {
    "participants": { "default": 8 },
    "formationLine": { "default": "Team DM formation ready: 4v4" }
  },
  "steps": [
    { "step": "status", "name": "status" },
    { "step": "raid", "name": "raid", "mode": "teamdeathmatch", "map": "BLOCK", "mapFromMenu": true, "participants": { "$ref": "/parameters/participants" }, "timeoutSeconds": 480 },
    { "step": "expect", "name": "markers", "what": "log", "contains": "Block Team DM: restored 20 box markers (USEC south / BEAR north)", "sinceStep": "raid", "withinSeconds": 60, "onFail": "continue" },
    { "step": "expect", "name": "formation", "what": "log", "contains": { "$ref": "/parameters/formationLine" }, "sinceStep": "raid", "withinSeconds": 60 },
    { "step": "player", "name": "player-held" },
    { "step": "bots", "name": "bots-held", "aliveOnly": true, "onFail": "continue" },
    { "step": "expect", "name": "gates-open", "what": "log", "contains": "Block Team DM gates open: all twenty formation paths revalidated", "sinceStep": "raid", "withinSeconds": 150 },
    { "step": "still", "name": "still-open", "id": "tdm-gates-open" },
    { "step": "bots", "name": "usec", "contains": "usec", "aliveOnly": true, "minCount": 1, "onFail": "continue" },
    { "step": "bots", "name": "bear", "contains": "bear", "aliveOnly": true, "minCount": 1, "onFail": "continue" },
    { "step": "sleep", "name": "settle", "seconds": 20 },
    { "step": "bots", "name": "all-bots", "aliveOnly": true, "minCount": 1, "onFail": "continue" },
    { "step": "player", "name": "player-before" },
    { "step": "teleport", "name": "routes", "dryRun": true, "path": true, "expect": "any", "points": [ [-29.3245, 6.1262, 71.6287], [-62.5245, 6.1262, 72.1887], [-12.88, 6.17, 87.03] ], "onFail": "continue" },
    { "step": "hook", "name": "kill", "action": "kill" },
    { "step": "wait", "name": "dead", "lifeEvent": "death", "timeoutSeconds": 30, "onFail": "continue" },
    { "step": "wait", "name": "respawned", "alive": true, "timeoutSeconds": 90 },
    { "step": "expect", "name": "respawn-log", "what": "log", "contains": "team player respawn", "sinceStep": "kill", "withinSeconds": 30, "onFail": "continue" },
    { "step": "player", "name": "player-after" },
    { "step": "still", "name": "still-respawn", "id": "tdm-after-respawn" },
    { "step": "expect", "what": "logAbsent", "level": "error", "sinceStep": "raid", "onFail": "continue" },
    { "step": "log-export", "name": "export", "onFail": "continue" }
  ],
  "finally": [ { "step": "leave", "whenStepStarted": "raid" } ]
}
