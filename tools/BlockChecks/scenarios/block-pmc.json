{
  "name": "block-pmc",
  "description": "Ordinary PMC raid on Block as the isolation control: no Team DM, Domination or pickup lines, player alive, no errors. The raid ends through the map's own exit \"Block South Gate\": the player is placed in its box on the south platform (-20.75, 7.48, 11.25) and extracts after its 8 s, so the test profile keeps its gear (a pause-menu disconnect would cost it).",
  "host": "host2",
  "steps": [
    { "step": "status", "name": "status" },
    { "step": "raid", "name": "raid", "mode": "pmc", "map": "block", "bots": "low", "timeoutSeconds": 480 },
    { "step": "sleep", "name": "settle", "seconds": 15 },
    { "step": "player", "name": "player" },
    { "step": "bots", "name": "bots", "aliveOnly": true, "onFail": "continue" },
    { "step": "expect", "what": "logAbsent", "contains": "Team DM", "sinceStep": "raid" },
    { "step": "expect", "what": "logAbsent", "contains": "Domination", "sinceStep": "raid" },
    { "step": "expect", "what": "logAbsent", "contains": "Arena pickup", "sinceStep": "raid" },
    { "step": "expect", "what": "logAbsent", "contains": "team-box", "sinceStep": "raid" },
    { "step": "still", "name": "still", "id": "pmc-ingame" },
    { "step": "expect", "what": "logAbsent", "level": "error", "sinceStep": "raid", "onFail": "continue" },
    { "step": "log-export", "name": "export", "onFail": "continue" }
  ],
  "finally": [
    { "step": "teleport", "name": "exit", "x": -20.75, "y": 7.48, "z": 11.25, "reachable": false, "whenStepStarted": "raid" },
    { "step": "wait", "name": "extracted", "inRaid": false, "timeoutSeconds": 60, "whenStepStarted": "raid" },
    { "step": "menu", "name": "menu", "whenStepStarted": "raid" }
  ]
}
