<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <RuntimeSource Condition="'$(RuntimeSource)'==''">../../ArenaMode.Client/Combat/Translocator/ArenaTranslocatorRuntime.cs</RuntimeSource>
    <DiscSource Condition="'$(DiscSource)'==''">../../ArenaMode.Client/Combat/Translocator/ArenaTranslocatorDisc.cs</DiscSource>
    <GeometrySource Condition="'$(GeometrySource)'==''">../../ArenaMode.Client/Combat/Translocator/ArenaTranslocatorGeometry.cs</GeometrySource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(RuntimeSource)" Link="Production/Runtime.cs" />
    <Compile Include="$(DiscSource)" Link="Production/Disc.cs" />
    <Compile Include="$(GeometrySource)" Link="Production/Geometry.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaAreaCatalog.cs" Link="Production/Area.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaMapCatalog.cs" Link="Production/Map.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaPopulationPolicy.cs" Link="Production/Population.cs" />
  </ItemGroup>
</Project>
