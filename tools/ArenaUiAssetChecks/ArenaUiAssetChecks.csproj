  <Compile Include="../../ArenaMode.Client/Combat/ArenaKill.cs" Link="Kill.cs" />
  <Compile Include="../../ArenaMode.Client/Combat/ArenaUncreditedDeath.cs" Link="BarbedDeath.cs" />
  <Compile Include="../../ArenaMode.Client/Combat/ScoreRules.cs" Link="Rules.cs" />
  <EmbeddedResource Include="../../ArenaMode.Client/Assets/Ui/*.png;../../ArenaMode.Client/Assets/Ui/NOTICE.md;../../ArenaMode.Client/Assets/Ui/SOURCES.json;../../ArenaMode.Client/Assets/Ui/MIT-LICENSE.txt"><LogicalName>ArenaMode.Ui.%(Filename)%(Extension)</LogicalName></EmbeddedResource>
  <EmbeddedResource Include="RetiredArtwork.json"><LogicalName>Checks.RetiredArtwork.json</LogicalName></EmbeddedResource>
 </ItemGroup>
