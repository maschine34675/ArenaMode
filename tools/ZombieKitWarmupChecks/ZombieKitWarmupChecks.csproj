<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ControllerSource Condition="'$(ControllerSource)' == ''">$(MSBuildThisFileDirectory)..\..\ArenaMode.Client\ArenaController.cs</ControllerSource>
    <LoadingSource Condition="'$(LoadingSource)' == ''">$(MSBuildThisFileDirectory)..\..\ArenaMode.Client\Kits\KitBundlePreloader.LoadingScreen.cs</LoadingSource>
    <PolicySource Condition="'$(PolicySource)' == ''">$(MSBuildThisFileDirectory)..\..\ArenaMode.Client\Kits\ZombieKitWarmupPolicy.cs</PolicySource>
    <PreloaderSource Condition="'$(PreloaderSource)' == ''">$(MSBuildThisFileDirectory)..\..\ArenaMode.Client\Kits\KitBundlePreloader.cs</PreloaderSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ControllerSource)" Link="Production/ArenaController.cs" />
    <Compile Include="$(LoadingSource)" Link="Production/KitBundlePreloader.LoadingScreen.cs" />
    <Compile Include="$(PolicySource)" Link="Production/ZombieKitWarmupPolicy.cs" />
    <Compile Include="$(PreloaderSource)" Link="Production/KitBundlePreloader.cs" />
    <Compile Include="../../ArenaMode.Client/Kits/KitPreloadPlan.cs" Link="Production/KitPreloadPlan.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaPopulationPolicy.cs" Link="Production/ArenaPopulationPolicy.cs" />
  </ItemGroup>
</Project>
