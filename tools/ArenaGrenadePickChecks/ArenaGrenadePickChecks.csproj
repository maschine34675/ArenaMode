<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ProductionReachSource Condition="'$(ProductionReachSource)' == ''">../../ArenaMode.Client/Kits/ArenaReachPatches.cs</ProductionReachSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductionReachSource)" Link="Production/ArenaReachPatches.cs" />
    <!-- The source contract reads the very file that was compiled, so a mutant
         copy is checked as itself rather than against the repository file. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProductionReachSource</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(ProductionReachSource)'))))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
