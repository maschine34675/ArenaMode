<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Allows a temporary mutation copy to prove the identity regression. -->
    <ArenaPursuitRuntimeSource Condition="'$(ArenaPursuitRuntimeSource)' == ''">$(MSBuildThisFileDirectory)..\..\ArenaMode.BigBrainCompat\ArenaPursuitRuntime.cs</ArenaPursuitRuntimeSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ArenaPursuitRuntimeSource)"
             Link="Production/ArenaPursuitRuntime.cs" />
  </ItemGroup>
</Project>
