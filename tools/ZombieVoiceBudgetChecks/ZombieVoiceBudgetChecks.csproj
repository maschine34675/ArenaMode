<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable><LangVersion>latest</LangVersion>
    <BudgetSource Condition="'$(BudgetSource)' == ''">../../ArenaMode.Client/Bots/ZombieVoiceBudget.cs</BudgetSource>
    <PolicySource Condition="'$(PolicySource)' == ''">../../ArenaMode.Client/Bots/ZombieVoiceBudgetPolicy.cs</PolicySource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="artifacts/**/*.cs" />
    <Compile Include="$(BudgetSource)" Link="Production/ZombieVoiceBudget.cs" />
    <Compile Include="$(PolicySource)" Link="Production/ZombieVoiceBudgetPolicy.cs" />
  </ItemGroup>
</Project>
