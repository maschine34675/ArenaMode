<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TauntSourceRoot Condition="'$(TauntSourceRoot)' == ''">../../ArenaMode.Client/Combat</TauntSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs"/><Compile Include="Doubles.cs"/>
    <Compile Include="$(TauntSourceRoot)/ArenaSelfGrenadeTaunt.cs" Link="Production/ArenaSelfGrenadeTaunt.cs"/>
    <Compile Include="$(TauntSourceRoot)/ArenaShotAwardHistory.cs" Link="Production/ArenaShotAwardHistory.cs"/>
    <Compile Include="$(TauntSourceRoot)/ArenaHitHistory.cs" Link="Production/ArenaHitHistory.cs"/>
    <Compile Include="$(TauntSourceRoot)/ArenaAdministrativeDeathGate.cs" Link="Production/ArenaAdministrativeDeathGate.cs"/>
    <Compile Include="$(MatchTextSource)" Link="Production/ArenaMatch.Text.cs"/>
    <Compile Include="../../ArenaMode.Client/Modes/ArenaAnnouncerCue.cs" Link="Production/ArenaAnnouncerCue.cs"/>
  </ItemGroup>
</Project>
