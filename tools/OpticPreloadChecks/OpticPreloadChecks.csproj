<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GuardSource Condition="'$(GuardSource)' == ''">../../ArenaMode.Client/Kits/KitOpticPreloadGuard.cs</GuardSource>
    <PreloaderSource Condition="'$(PreloaderSource)' == ''">../../ArenaMode.Client/Kits/KitBundlePreloader.cs</PreloaderSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GuardSource)" Link="Production/KitOpticPreloadGuard.cs" />
    <Compile Include="$(PreloaderSource)" Link="Production/KitBundlePreloader.cs" />
    <Compile Include="../../ArenaMode.Client/Kits/KitPreloadPlan.cs" Link="Production/KitPreloadPlan.cs" />
    <Compile Include="../../ArenaMode.Shared/ArenaPopulationPolicy.cs" Link="Production/ArenaPopulationPolicy.cs" />
  </ItemGroup>
</Project>
