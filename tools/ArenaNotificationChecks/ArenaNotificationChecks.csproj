<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NotificationSource Condition="'$(NotificationSource)' == ''">$(MSBuildThisFileDirectory)..\..\ArenaMode.Client\Notifications\ArenaProgressNotifications.cs</NotificationSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(NotificationSource)" Link="Production/ArenaProgressNotifications.cs" />
  </ItemGroup>
</Project>
