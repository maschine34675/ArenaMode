<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ProductionTuningSource Condition="'$(ProductionTuningSource)' == ''">../../ArenaMode.Client/Movement/ArenaWeightTuning.cs</ProductionTuningSource>
    <ProductionPatchSource Condition="'$(ProductionPatchSource)' == ''">../../ArenaMode.Client/Movement/ArenaWeightPatches.cs</ProductionPatchSource>
    <ProductionRuntimeSource Condition="'$(ProductionRuntimeSource)' == ''">../../ArenaMode.Client/Movement/MovementRuntime.cs</ProductionRuntimeSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductionTuningSource)" Link="Production/ArenaWeightTuning.cs" />
    <Compile Include="$(ProductionPatchSource)" Link="Production/ArenaWeightPatches.cs" />
    <Compile Include="$(ProductionRuntimeSource)" Link="Production/MovementRuntime.cs" />
  </ItemGroup>
</Project>
