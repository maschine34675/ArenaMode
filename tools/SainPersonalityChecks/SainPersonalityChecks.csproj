<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Deliberate stand-in assembly identity used by the optional adapter. -->
    <AssemblyName>SAIN</AssemblyName>
    <AssemblyVersion>4.5.1.0</AssemblyVersion>
    <ProductionSource Condition="'$(ProductionSource)' == ''">../../ArenaMode.Client/Bots/ArenaSainPersonalities.cs</ProductionSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductionSource)" Link="Production/ArenaSainPersonalities.cs" />
  </ItemGroup>
</Project>
