<!-- Sdk.Web, not Sdk: the Blazor config page needs the Razor compiler and
     the ASP.NET reference assemblies. OutputType stays Library - this is
     still a mod the server loads, not a host that runs itself. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\Shared.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ArenaMode.Server</RootNamespace>
    <AssemblyName>maschine-ArenaMode.Server</AssemblyName>
    <Company>https://github.com/maschine34675/ArenaMode</Company>
    <Authors>maschine</Authors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <OutputPath>..\build\server\$(Configuration)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <SPTUserMods>$(SPTUserPath)\user\mods\</SPTUserMods>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ArenaMode.Shared\Protocol.cs" Link="Shared\Protocol.cs" />
    <Compile Include="..\ArenaMode.Shared\ClientSettingsModels.cs" Link="Shared\ClientSettingsModels.cs" />
    <Compile Include="..\ArenaMode.Shared\ArenaBotSpawnPolicy.cs" Link="Shared\ArenaBotSpawnPolicy.cs" />
    <Compile Include="..\ArenaMode.Shared\ArenaMapCatalog.cs" Link="Shared\ArenaMapCatalog.cs" />
    <Compile Include="..\ArenaMode.Shared\ArenaAreaCatalog.cs" Link="Shared\ArenaAreaCatalog.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Server.Web" Version="4.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <Target Name="DeployToSpt" AfterTargets="Build" Condition="Exists('$(SPTUserMods)')">
    <MakeDir Directories="$(SPTUserMods)ArenaMode\" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(SPTUserMods)ArenaMode\" SkipUnchangedFiles="true" />
    <!-- Default kit catalog: deployed once, user edits are never overwritten. -->
    <MakeDir Directories="$(SPTUserMods)ArenaMode\config\" Condition="!Exists('$(SPTUserMods)ArenaMode\config\kits.json')" />
    <Copy SourceFiles="defaults\kits.json" DestinationFolder="$(SPTUserMods)ArenaMode\config\" Condition="!Exists('$(SPTUserMods)ArenaMode\config\kits.json')" />
    <Copy SourceFiles="defaults\ladder.json" DestinationFolder="$(SPTUserMods)ArenaMode\config\" Condition="!Exists('$(SPTUserMods)ArenaMode\config\ladder.json')" />
  </Target>

</Project>
