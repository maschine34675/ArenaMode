<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Shared.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ArenaMode.Server</RootNamespace>
    <AssemblyName>maschine-ArenaMode.Server</AssemblyName>
    <Company>https://github.com/maschine34675/ArenaMode</Company>
    <Authors>maschine</Authors>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <OutputPath>..\build\server\$(Configuration)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <SPTUserMods>$(SPTUserPath)\user\mods\</SPTUserMods>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ArenaMode.Shared\Protocol.cs" Link="Shared\Protocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.1.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="DeployToSpt" AfterTargets="Build" Condition="Exists('$(SPTUserMods)')">
    <MakeDir Directories="$(SPTUserMods)ArenaMode\" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(SPTUserMods)ArenaMode\" SkipUnchangedFiles="true" />
    <!-- Default kit catalog: deployed once, user edits are never overwritten. -->
    <MakeDir Directories="$(SPTUserMods)ArenaMode\config\" Condition="!Exists('$(SPTUserMods)ArenaMode\config\kits.json')" />
    <Copy SourceFiles="defaults\kits.json" DestinationFolder="$(SPTUserMods)ArenaMode\config\" Condition="!Exists('$(SPTUserMods)ArenaMode\config\kits.json')" />
  </Target>

</Project>
