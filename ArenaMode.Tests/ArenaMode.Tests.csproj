<!-- Tests cover the SERVER half and the generated data. The client half is not
     here on purpose: it is Harmony patches against Unity and EFT types that
     cannot be loaded outside the game, so anything testable there would be a
     mock of the game rather than the game. What IS here is everything that
     broke repeatedly during development, all of which is pure data. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- Not deployed anywhere; keep it out of the mod output folders. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Skippable tests: the template-existence checks need the game database,
         which only exists on a machine with Tarkov installed. Skipping is
         honest there; passing silently is not. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArenaMode.Server\ArenaMode.Server.csproj" />
  </ItemGroup>

  <!-- The scoreboard is intentionally pure match data even though it ships in
       the client DLL. Link that rule layer directly so identity and scoring can
       be exercised without loading Unity or EFT. -->
  <ItemGroup>
    <Compile Include="..\ArenaMode.Client\Combat\ArenaKill.cs" Link="ClientRules\ArenaKill.cs" />
    <Compile Include="..\ArenaMode.Client\Session\ArenaRestoreCommit.cs" Link="ClientRules\ArenaRestoreCommit.cs" />
    <Compile Include="..\ArenaMode.Client\Combat\ArenaHitHistory.cs" Link="ClientRules\ArenaHitHistory.cs" />
    <Compile Include="..\ArenaMode.Client\Combat\ArenaShotAwardHistory.cs" Link="ClientRules\ArenaShotAwardHistory.cs" />
    <Compile Include="..\ArenaMode.Client\Combat\ArenaCombatAwards.cs" Link="ClientRules\ArenaCombatAwards.cs" />
    <Compile Include="..\ArenaMode.Client\Combat\ArenaAdministrativeDeathGate.cs" Link="ClientRules\ArenaAdministrativeDeathGate.cs" />
    <Compile Include="..\ArenaMode.Client\Combat\ScoreRules.cs" Link="ClientRules\ScoreRules.cs" />
    <Compile Include="..\ArenaMode.Client\Modes\ArenaScoreboard.cs" Link="ClientRules\ArenaScoreboard.cs" />
    <Compile Include="..\ArenaMode.Client\Bots\BotLoadBoostPolicy.cs" Link="ClientRules\BotLoadBoostPolicy.cs" />
    <Compile Include="..\ArenaMode.Client\Kits\AutoQuickSlotLedger.cs" Link="ClientRules\AutoQuickSlotLedger.cs" />
    <Compile Include="..\ArenaMode.Client\Kits\KitModels.cs" Link="ClientRules\KitModels.cs" />
    <Compile Include="..\ArenaMode.Client\Kits\KitPreloadPlan.cs" Link="ClientRules\KitPreloadPlan.cs" />
    <Compile Include="..\ArenaMode.Client\Modes\SoloTacticalRoundStartPolicy.cs" Link="ClientRules\SoloTacticalRoundStartPolicy.cs" />
    <Compile Include="..\ArenaMode.Client\Modes\ZombieWavePolicy.cs" Link="ClientRules\ZombieWavePolicy.cs" />
    <Compile Include="..\ArenaMode.Client\Modes\ZombieRoleMix.cs" Link="ClientRules\ZombieRoleMix.cs" />
    <Compile Include="..\ArenaMode.Client\Modes\ZombieProfilePlan.cs" Link="ClientRules\ZombieProfilePlan.cs" />
    <Compile Include="..\ArenaMode.Client\Modes\ZombieRefillPolicy.cs" Link="ClientRules\ZombieRefillPolicy.cs" />
    <Compile Include="..\ArenaMode.Client\Modes\ZombieOwnGearGate.cs" Link="ClientRules\ZombieOwnGearGate.cs" />
    <Compile Include="..\ArenaMode.Client\Bots\ZombieMeleeGate.cs" Link="ClientRules\ZombieMeleeGate.cs" />
  </ItemGroup>

  <!-- Referenced again here WITHOUT ExcludeAssets, which the server project sets
       because the live server already provides these at runtime. A test host does
       not, so without this every test that touches an SPT model type fails to
       load the assembly rather than failing an assertion. -->
  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.0" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.0" />
    <PackageReference Include="SPTarkov.Reflection" Version="4.1.0" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" />
  </ItemGroup>

</Project>
