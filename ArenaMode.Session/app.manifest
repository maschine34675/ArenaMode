<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- The helper never needs elevation: junctions, copies and child processes all work as the
       user who runs the game. asInvoker also switches off the installer-detection heuristics. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 (and Server 2016+) -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <!-- The arena tree sits deeper than the installed server (%LOCALAPPDATA%\maschine-ArenaMode\session\server\...),
       so a mod path that fits below MAX_PATH in the install can exceed it in the copy. With this and the
       Windows "long paths" setting, .NET Framework 4.6.2+ and the Win32 calls accept up to 32767 characters.
       Without the Windows setting a too long path fails loudly (logged) and the normal session is restored. -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
